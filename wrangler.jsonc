{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meridian-estimator",
  "compatibility_date": "2026-10-08",
  "main": "./src/worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "PINGONE_MOCK": "false",
    "PINGONE_ENV_ID": "c74a4945-1364-4966-9a68-abeaa3e7b767",
    "PINGONE_CLIENT_ID": "55833d59-268f-4355-a46c-030fdf10c206",
    "PINGONE_AUTH_HOST": "https://auth.pingone.com",
    "PINGONE_SCOPES": "openid profile email offline_access",
    "AI_PILOT_GATE_ENABLED": "true",
    "AI_PILOT_GROUP": "Meridian AI Pilot",
    "AI_PILOT_GROUPS_CLAIM": "groups",
    "AI_USER_CALLS_PER_HOUR": "30",
    "AI_USER_TOKENS_PER_DAY": "100000",
    "AI_DAILY_BUDGET_USD": "5"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meridian-estimator",
      "database_id": "dd46e860-73bc-4da1-a046-fbb4a9d46574",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "c0418464653d42f195ce3efacae3351c"
    }
  ]
}
