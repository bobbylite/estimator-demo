# Copy to .dev.vars for local development. Never commit .dev.vars.
# Mock mode is ON here so the app runs without a PingOne tenant.
# Production wrangler.jsonc sets PINGONE_MOCK=false. Do not ship mock mode.

PINGONE_MOCK=true
PINGONE_ENV_ID=
PINGONE_AUTH_HOST=https://auth.pingone.com
PINGONE_CLIENT_ID=
PINGONE_CLIENT_SECRET=
PINGONE_REDIRECT_URI=
PINGONE_SCOPES=openid profile email offline_access

# Pilot gate is on in the local mock so the demo can show a member and a non-member.
# Production wrangler.jsonc sets AI_PILOT_GATE_ENABLED=true.
# These are plain Worker vars, not secrets. JEV_API_KEY, when used, is a secret.
AI_PILOT_GATE_ENABLED=true
AI_PILOT_GROUP=Meridian AI Pilot
AI_PILOT_GROUPS_CLAIM=groups
AI_USER_CALLS_PER_HOUR=30
AI_USER_TOKENS_PER_DAY=100000
AI_DAILY_BUDGET_USD=5

# Optional. Mock mode does not call Jev. In production this is a Worker secret, not a var:
# npx wrangler secret put JEV_API_KEY
